<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FFmpegUI.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Grid Margin="32,24,32,32" MaxWidth="1080" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Uid="TasksPageTitle" Grid.Row="0" Text="任务队列" Style="{StaticResource PageTitleStyle}"/>
        <TextBlock x:Uid="TasksPageSubtitle" Grid.Row="1"
                   Text="所有处理任务都在此排队执行，可随时查看进度、取消任务或查看完整日志。"
                   Style="{StaticResource PageSubtitleStyle}"/>

        <!-- 提示条 -->
        <InfoBar Grid.Row="2"
                 IsOpen="{x:Bind ViewModel.ShowStatus, Mode=OneWay}"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                 Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                 IsClosable="True"
                 Margin="0,0,0,16"/>

        <!-- 任务列表卡片 -->
        <Border Grid.Row="3"
                Style="{StaticResource CardStyle}"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 统计与操作栏：使用 CommandBar 承载主要操作，符合官方工具栏规范 -->
                <Grid Grid.Row="0" Padding="16,12" BorderThickness="0,0,0,1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Uid="TasksRunningLabel" Text="进行中" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.RunningCount, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Uid="TasksPendingLabel" Text="等待中" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.PendingCount, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Uid="TasksCompletedLabel" Text="已完成" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.CompletedCount, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Uid="TasksFailedLabel" Text="失败/取消" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.FailedCount, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <CommandBar Grid.Column="1"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                DefaultLabelPosition="Right"
                                IsOpen="False">
                        <AppBarButton x:Uid="StartAllButton"
                                      Icon="Play"
                                      Label="全部开始"
                                      Command="{x:Bind ViewModel.StartAllCommand}"/>
                        <AppBarButton x:Uid="CancelAllButton"
                                      Icon="Cancel"
                                      Label="全部取消"
                                      Command="{x:Bind ViewModel.CancelAllCommand}"/>
                        <AppBarButton x:Uid="ViewLogButton"
                                      Icon="OpenFile"
                                      Label="日志"
                                      Command="{x:Bind ViewModel.ViewLogCommand}"/>
                        <AppBarButton x:Uid="ClearFinishedButton"
                                      Icon="Delete"
                                      Label="清除已完成"
                                      Command="{x:Bind ViewModel.ClearFinishedCommand}"/>
                        <AppBarButton x:Uid="OpenFolderButton"
                                      Icon="Folder"
                                      Label="打开目录"
                                      Command="{x:Bind ViewModel.OpenFolderCommand}"/>
                    </CommandBar>
                </Grid>

                <!-- 列表 -->
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedTask, Mode=TwoWay}"
                          ItemTemplate="{StaticResource TaskItemTemplate}"
                          SelectionMode="Single"
                          Padding="16,4">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="8,0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- 空状态 -->
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="4"
                            Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}">
                    <FontIcon Glyph="&#xE8FD;" Style="{StaticResource EmptyStateIconStyle}"/>
                    <TextBlock x:Uid="TasksEmptyTitle" Text="暂无任务" Style="{StaticResource EmptyStateTitleStyle}"/>
                    <TextBlock x:Uid="TasksEmptyHint"
                               Text="在左侧任一一页配置参数后点击「添加到任务队列」即可开始处理。"
                               Style="{StaticResource EmptyStateDescriptionStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 输出面板：实时显示选中任务的 ffmpeg 错误 / 警告 / 全部日志 -->
        <Border Grid.Row="4"
                Style="{StaticResource CardStyle}"
                Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Padding="16,12"
                      BorderThickness="0,0,0,1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="输出"
                               Style="{StaticResource CardTitleStyle}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <ToggleSwitch x:Uid="OutputErrorsOnlyToggle"
                                      Header="仅错误和警告"
                                      MinWidth="0"
                                      IsOn="{x:Bind ViewModel.ShowOnlyErrors, Mode=TwoWay}"/>
                        <Button x:Uid="OutputCopyButton"
                                Content="复制"
                                Command="{x:Bind ViewModel.CopyLogCommand}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Padding="16">
                        <TextBox Text="{x:Bind ViewModel.LogText, Mode=OneWay}"
                                 Style="{StaticResource MonospaceTextStyle}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 TextWrapping="NoWrap"
                                 MinHeight="160"
                                 MaxHeight="320"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </ScrollViewer>

                    <TextBlock Text="选择一个任务以查看其输出日志"
                               Style="{StaticResource EmptyStateDescriptionStyle}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.HasLog, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
