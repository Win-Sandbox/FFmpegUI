<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FFmpegUI.Views.TrimPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FFmpegUI.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32" Spacing="16" MaxWidth="1080" HorizontalAlignment="Stretch">

            <TextBlock x:Uid="TrimPageTitle" Text="剪辑" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock x:Uid="TrimPageSubtitle"
                       Text="截取片段、裁剪画面、旋转镜像、调整速度与音量。不启用任何画面处理时可直接复制流，速度极快且无损。"
                       Style="{StaticResource PageSubtitleStyle}"/>

            <InfoBar IsOpen="{x:Bind ViewModel.ShowStatus, Mode=OneWay}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                     IsClosable="True"/>

            <!-- ===== 输入文件 ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="InputSectionTitle" Text="输入文件" Style="{StaticResource CardTitleStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Uid="TrimInputPathBox"
                                 Text="{x:Bind ViewModel.InputPath, Mode=TwoWay}"
                                 PlaceholderText="选择或粘贴要剪辑的文件路径"/>
                        <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch"
                                Style="{StaticResource IconButtonStyle}"
                                AutomationProperties.Name="{Binding Text, ElementName=BrowseButtonText}"
                                Command="{x:Bind ViewModel.PickInputCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="16"/>
                                <TextBlock x:Name="BrowseButtonText" x:Uid="BrowseButton" Text="浏览"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Margin="0,8,0,0">
                        <Run x:Uid="TrimDurationLabel" Text="文件时长："/>
                        <Run Text="{x:Bind ViewModel.DurationText, Mode=OneWay}"/>
                    </TextBlock>

                    <TextBlock Text="{x:Bind ViewModel.InputSummary, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- ===== 时间范围 ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="TrimRangeSectionTitle" Text="截取范围" Style="{StaticResource CardTitleStyle}"/>

                    <controls:SettingRow x:Uid="TrimRowTimeMode" Title="指定方式">
                        <controls:SettingRow.SettingContent>
                            <RadioButtons SelectedIndex="{x:Bind ViewModel.TimeModeIndex, Mode=TwoWay}" MaxColumns="2">
                                <RadioButton x:Uid="TrimTimeModeRange" Content="开始时间 + 结束时间"/>
                                <RadioButton x:Uid="TrimTimeModeDuration" Content="开始时间 + 时长"/>
                            </RadioButtons>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TrimRowStartTime" Title="开始时间（秒）" Description="从此处开始截取">
                        <controls:SettingRow.SettingContent>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <NumberBox Value="{x:Bind ViewModel.StartSeconds, Mode=TwoWay}"
                                           Minimum="0" Maximum="86400" SmallChange="1"
                                           SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" MinWidth="160"/>
                                <TextBlock Text="{x:Bind ViewModel.StartTimeText, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TrimRowEndTime" Title="结束时间（秒）" Description="留空或 0 表示截取到文件结尾"
                                         Visibility="{x:Bind ViewModel.IsEndTimeVisible, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <NumberBox Value="{x:Bind ViewModel.EndSeconds, Mode=TwoWay}"
                                           Minimum="0" Maximum="86400" SmallChange="1"
                                           SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" MinWidth="160"/>
                                <TextBlock Text="{x:Bind ViewModel.EndTimeText, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TrimRowDuration" Title="截取时长（秒）"
                                         Visibility="{x:Bind ViewModel.IsDurationVisible, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <NumberBox Value="{x:Bind ViewModel.DurationSeconds, Mode=TwoWay}"
                                       Minimum="0" Maximum="86400" SmallChange="1"
                                       SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" MinWidth="160"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TrimRowFastSeek"
                                         Title="快速定位"
                                         Description="关闭时定位更精确但速度较慢，需要精确剪辑时请关闭">
                        <controls:SettingRow.SettingContent>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.SeekBeforeInput, Mode=TwoWay}"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- ===== 编码方式 ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="TrimEncodeSectionTitle" Text="编码方式" Style="{StaticResource CardTitleStyle}"/>

                    <controls:SettingRow x:Uid="TrimRowEncodeMode"
                                         Title="处理方式"
                                         Description="启用裁剪、旋转、变速或音量调整时会自动切换为重新编码">
                        <controls:SettingRow.SettingContent>
                            <RadioButtons SelectedIndex="{x:Bind ViewModel.EncodeModeIndex, Mode=TwoWay}" MaxColumns="2">
                                <RadioButton x:Uid="TrimEncodeCopy" Content="复制流（无损，速度快）"/>
                                <RadioButton x:Uid="TrimEncodeReencode" Content="重新编码（可应用画面调整）"/>
                            </RadioButtons>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TrimRowCrf" Title="CRF 值" Description="0–51，数值越小质量越高"
                                         Visibility="{x:Bind ViewModel.IsEncodeOptionVisible, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Slider Minimum="0" Maximum="51" StepFrequency="1" HorizontalAlignment="Stretch" MaxWidth="240"
                                        Value="{x:Bind ViewModel.Crf, Mode=TwoWay}"/>
                                <NumberBox Value="{x:Bind ViewModel.Crf, Mode=TwoWay}"
                                           Minimum="0" Maximum="51" SmallChange="1"
                                           SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" MinWidth="120"/>
                            </StackPanel>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TrimRowAudioBitrate"
                                         Title="音频码率 (kbps)"
                                         Visibility="{x:Bind ViewModel.IsEncodeOptionVisible, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <NumberBox Value="{x:Bind ViewModel.AudioBitrateKbps, Mode=TwoWay}"
                                       Minimum="32" Maximum="1536" SmallChange="32"
                                           SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" MinWidth="160"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- ===== 画面调整 ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="TrimVisualSectionTitle" Text="画面调整" Style="{StaticResource CardTitleStyle}"/>

                    <controls:SettingRow x:Uid="TrimRowCrop" Title="裁剪画面 (crop)" Description="启用后需要重新编码">
                        <controls:SettingRow.SettingContent>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.EnableCrop, Mode=TwoWay}"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <StackPanel Visibility="{x:Bind ViewModel.IsCropVisible, Mode=OneWay}">
                        <controls:SettingRow x:Uid="TrimRowCropSize" Title="裁剪区域">
                            <controls:SettingRow.SettingContent>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <NumberBox x:Uid="WidthNumberBox"
                                               Value="{x:Bind ViewModel.CropWidth, Mode=TwoWay}"
                                               Minimum="0" SmallChange="2"
                                               SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten"
                                               PlaceholderText="宽" Width="110"/>
                                    <NumberBox x:Uid="HeightNumberBox"
                                               Value="{x:Bind ViewModel.CropHeight, Mode=TwoWay}"
                                               Minimum="0" SmallChange="2"
                                               SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten"
                                               PlaceholderText="高" Width="110"/>
                                </StackPanel>
                            </controls:SettingRow.SettingContent>
                        </controls:SettingRow>

                        <controls:SettingRow x:Uid="TrimRowCropOrigin" Title="起始坐标" Description="裁剪区域左上角在原画面中的位置">
                            <controls:SettingRow.SettingContent>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <NumberBox x:Uid="XNumberBox"
                                               Value="{x:Bind ViewModel.CropX, Mode=TwoWay}"
                                               Minimum="0" SmallChange="2"
                                               SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten"
                                               PlaceholderText="X" Width="110"/>
                                    <NumberBox x:Uid="YNumberBox"
                                               Value="{x:Bind ViewModel.CropY, Mode=TwoWay}"
                                               Minimum="0" SmallChange="2"
                                               SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten"
                                               PlaceholderText="Y" Width="110"/>
                                </StackPanel>
                            </controls:SettingRow.SettingContent>
                        </controls:SettingRow>
                    </StackPanel>

                    <controls:SettingRow x:Uid="TrimRowRotate" Title="旋转">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.RotateOptions}"
                                      DisplayMemberPath="Key"
                                      SelectedIndex="{x:Bind ViewModel.RotateIndex, Mode=TwoWay}"
                                      MinWidth="200"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TrimRowFlip" Title="翻转">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.FlipOptions}"
                                      DisplayMemberPath="Key"
                                      SelectedIndex="{x:Bind ViewModel.FlipIndex, Mode=TwoWay}"
                                      MinWidth="200"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- ===== 速度与音量 ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="TrimSpeedSectionTitle" Text="速度与音量" Style="{StaticResource CardTitleStyle}"/>

                    <controls:SettingRow x:Uid="TrimRowSpeedEnable" Title="调整播放速度" Description="例如 2 表示 2 倍速，0.5 表示半速">
                        <controls:SettingRow.SettingContent>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.EnableSpeed, Mode=TwoWay}"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TrimRowSpeed" Title="速度倍数" Description="支持 0.25–4.0，音视频保持同步"
                                         Visibility="{x:Bind ViewModel.IsSpeedVisible, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Slider Minimum="0.25" Maximum="4" StepFrequency="0.05" HorizontalAlignment="Stretch" MaxWidth="240"
                                        Value="{x:Bind ViewModel.Speed, Mode=TwoWay}"/>
                                <NumberBox Value="{x:Bind ViewModel.Speed, Mode=TwoWay}"
                                           Minimum="0.25" Maximum="4" SmallChange="0.05"
                                           SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" MinWidth="120"/>
                            </StackPanel>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TrimRowVolumeEnable" Title="调整音量">
                        <controls:SettingRow.SettingContent>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.EnableVolume, Mode=TwoWay}"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TrimRowVolume" Title="音量增益 (dB)" Description="正数增大，负数减小"
                                         Visibility="{x:Bind ViewModel.IsVolumeVisible, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Slider Minimum="-30" Maximum="30" StepFrequency="1" HorizontalAlignment="Stretch" MaxWidth="240"
                                        Value="{x:Bind ViewModel.VolumeDb, Mode=TwoWay}"/>
                                <NumberBox Value="{x:Bind ViewModel.VolumeDb, Mode=TwoWay}"
                                           Minimum="-30" Maximum="30" SmallChange="1"
                                           SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" MinWidth="120"/>
                            </StackPanel>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- ===== 输出与执行 ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="OutputSectionTitle" Text="输出" Style="{StaticResource CardTitleStyle}"/>

                    <controls:SettingRow x:Uid="TrimRowOutputPath" Title="输出文件">
                        <controls:SettingRow.SettingContent>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Uid="OutputPathBox"
                                         Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay}"
                                         PlaceholderText="输出文件路径" MinWidth="360"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource IconButtonStyle}"
                                        AutomationProperties.Name="{Binding Text, ElementName=SaveAsButtonText}"
                                        Command="{x:Bind ViewModel.PickOutputCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE792;" FontSize="16"/>
                                        <TextBlock x:Name="SaveAsButtonText" x:Uid="SaveAsButton" Text="另存为"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:OutputNameControl OutputNameOptions="{x:Bind ViewModel.OutputNameOptions}"
                                                 Margin="0,4"/>

                    <TextBlock x:Uid="CommandPreviewTitle" Text="命令预览" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource CodeBlockStyle}">
                        <TextBlock Text="{x:Bind ViewModel.CommandPreview, Mode=OneWay}"
                                   Style="{StaticResource MonospaceTextStyle}"/>
                    </Border>

                    <Button Style="{StaticResource AccentIconButtonStyle}"
                            Margin="0,16,0,0"
                            AutomationProperties.Name="{Binding Text, ElementName=AddToQueueButtonText}"
                            Command="{x:Bind ViewModel.AddToQueueCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="16"/>
                            <TextBlock x:Name="AddToQueueButtonText" x:Uid="AddToQueueButton" Text="添加到任务队列"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButtonStyle}"
                            Margin="0,16,0,0"
                            AutomationProperties.Name="扫描文件夹批量添加"
                            Command="{x:Bind ViewModel.ScanFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16"/>
                            <TextBlock Text="扫描文件夹批量添加"/>
                        </StackPanel>
                    </Button>

                    <InfoBar IsOpen="{x:Bind ViewModel.LastAddedVisible, Mode=OneWay}"
                             Message="{x:Bind ViewModel.LastAddedMessage, Mode=OneWay}"
                             Severity="Success"
                             Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
