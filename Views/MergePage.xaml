<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FFmpegUI.Views.MergePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FFmpegUI.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32" Spacing="16" MaxWidth="1080" HorizontalAlignment="Stretch">

            <TextBlock x:Uid="MergePageTitle" Text="合并与混流" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock x:Uid="MergePageSubtitle"
                       Text="把多个视频按顺序合并、为视频替换音轨，或将图片序列合成为视频。"
                       Style="{StaticResource PageSubtitleStyle}"/>

            <InfoBar IsOpen="{x:Bind ViewModel.ShowStatus, Mode=OneWay}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                     IsClosable="True"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="MergeModeSectionTitle" Text="处理方式" Style="{StaticResource CardTitleStyle}"/>

                    <controls:SettingRow x:Uid="MergeRowMode" Title="选择功能">
                        <controls:SettingRow.SettingContent>
                            <RadioButtons SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}" MaxColumns="3">
                                <RadioButton x:Uid="MergeModeVideo" Content="视频合并"/>
                                <RadioButton x:Uid="MergeModeMux" Content="音视频混流"/>
                                <RadioButton x:Uid="MergeModeImage" Content="图片序列合成视频"/>
                            </RadioButtons>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- ===== 视频合并 ===== -->
            <Border Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.IsVideoMergeMode, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="MergeFileListTitle" Text="要合并的文件（按顺序）" Style="{StaticResource CardTitleStyle}"/>

                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            MinHeight="180"
                            MaxHeight="320">
                        <ListView ItemsSource="{x:Bind ViewModel.Files, Mode=OneWay}"
                                  SelectedIndex="{x:Bind ViewModel.SelectedFileIndex, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  Padding="4">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind}"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource IconButtonStyle}"
                                AutomationProperties.Name="{Binding Text, ElementName=AddFilesButtonText}"
                                Command="{x:Bind ViewModel.AddFilesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="16"/>
                                <TextBlock x:Name="AddFilesButtonText" x:Uid="AddFilesButton" Text="添加文件"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                AutomationProperties.Name="{Binding Text, ElementName=RemoveFileButtonText}"
                                Command="{x:Bind ViewModel.RemoveFileCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74C;" FontSize="16"/>
                                <TextBlock x:Name="RemoveFileButtonText" x:Uid="RemoveFileButton" Text="移除"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                AutomationProperties.Name="{Binding Text, ElementName=ClearFilesButtonText}"
                                Command="{x:Bind ViewModel.ClearFilesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                                <TextBlock x:Name="ClearFilesButtonText" x:Uid="ClearFilesButton" Text="清空"/>
                            </StackPanel>
                        </Button>
                        <!-- 官方 a11y 规范：无文本的图标按钮必须提供 AutomationProperties.Name
                             （屏幕阅读器可访问名称），ToolTip 不能替代；两者都经 x:Uid 本地化 -->
                        <Button x:Uid="TipMoveUp"
                                Style="{StaticResource IconButtonStyle}"
                                Width="36"
                                Padding="8"
                                AutomationProperties.Name="上移"
                                Command="{x:Bind ViewModel.MoveUpCommand}">
                            <FontIcon Glyph="&#xE74A;" FontSize="16"/>
                        </Button>
                        <Button x:Uid="TipMoveDown"
                                Style="{StaticResource IconButtonStyle}"
                                Width="36"
                                Padding="8"
                                AutomationProperties.Name="下移"
                                Command="{x:Bind ViewModel.MoveDownCommand}">
                            <FontIcon Glyph="&#xE74B;" FontSize="16"/>
                        </Button>
                    </StackPanel>

                    <controls:SettingRow x:Uid="MergeRowMethod" Title="合并方式" Margin="0,8,0,0">
                        <controls:SettingRow.SettingContent>
                            <RadioButtons SelectedIndex="{x:Bind ViewModel.MergeMethodIndex, Mode=TwoWay}" MaxColumns="2">
                                <RadioButton x:Uid="MergeMethodCopy" Content="无损合并（直接复制流）"/>
                                <RadioButton x:Uid="MergeMethodReencode" Content="重新编码（兼容性最好）"/>
                            </RadioButtons>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="MergeRowCrf" Title="CRF 值" Description="仅在重新编码时生效">
                        <controls:SettingRow.SettingContent>
                            <NumberBox Value="{x:Bind ViewModel.Crf, Mode=TwoWay}"
                                       Minimum="0" Maximum="51" SmallChange="1"
                                       SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" MinWidth="160"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- ===== 音视频混流 ===== -->
            <Border Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.IsMuxMode, Mode=OneWay}">
                <StackPanel>
                    <TextBlock x:Uid="MergeMuxSectionTitle" Text="音视频混流" Style="{StaticResource CardTitleStyle}"/>

                    <controls:SettingRow x:Uid="MergeRowVideoFile" Title="视频文件（提供画面）">
                        <controls:SettingRow.SettingContent>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Uid="MergeVideoFileBox"
                                         Text="{x:Bind ViewModel.VideoFilePath, Mode=TwoWay}"
                                         PlaceholderText="选择视频文件" MinWidth="360"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource IconButtonStyle}"
                                        AutomationProperties.Name="{Binding Text, ElementName=BrowseVideoButtonText}"
                                        Command="{x:Bind ViewModel.PickVideoCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="16"/>
                                        <TextBlock x:Name="BrowseVideoButtonText" x:Uid="BrowseVideoButton" Text="浏览"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="MergeRowAudioFile" Title="音频文件（提供声音）">
                        <controls:SettingRow.SettingContent>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Uid="MergeAudioFileBox"
                                         Text="{x:Bind ViewModel.AudioFilePath, Mode=TwoWay}"
                                         PlaceholderText="选择音频文件" MinWidth="360"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource IconButtonStyle}"
                                        AutomationProperties.Name="{Binding Text, ElementName=BrowseAudioButtonText}"
                                        Command="{x:Bind ViewModel.PickAudioCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="16"/>
                                        <TextBlock x:Name="BrowseAudioButtonText" x:Uid="BrowseAudioButton" Text="浏览"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="MergeRowMuxMethod" Title="处理方式" Description="编码参数一致时可直接复制流">
                        <controls:SettingRow.SettingContent>
                            <RadioButtons SelectedIndex="{x:Bind ViewModel.MergeMethodIndex, Mode=TwoWay}" MaxColumns="2">
                                <RadioButton x:Uid="MergeMuxCopy" Content="直接复制流"/>
                                <RadioButton x:Uid="MergeMuxReencode" Content="重新编码"/>
                            </RadioButtons>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- ===== 图片序列 ===== -->
            <Border Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.IsImageSequenceMode, Mode=OneWay}">
                <StackPanel>
                    <TextBlock x:Uid="MergeImageSectionTitle" Text="图片序列合成视频" Style="{StaticResource CardTitleStyle}"/>

                    <controls:SettingRow x:Uid="MergeRowImagePattern"
                                         Title="图片序列模式"
                                         Description="使用 %05d 表示 5 位序号，例如 C:\frames\img%05d.png">
                        <controls:SettingRow.SettingContent>
                            <TextBox x:Uid="MergeImagePatternBox"
                                     Text="{x:Bind ViewModel.ImagePattern, Mode=TwoWay}"
                                     PlaceholderText="C:\frames\img%05d.png" MinWidth="420"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="MergeRowFrameRate" Title="帧率 (fps)">
                        <controls:SettingRow.SettingContent>
                            <NumberBox Value="{x:Bind ViewModel.FrameRate, Mode=TwoWay}"
                                       Minimum="1" Maximum="120" SmallChange="1"
                                       SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" Width="160"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="MergeRowImageCrf" Title="CRF 值" Description="数值越小质量越高">
                        <controls:SettingRow.SettingContent>
                            <NumberBox Value="{x:Bind ViewModel.Crf, Mode=TwoWay}"
                                       Minimum="0" Maximum="51" SmallChange="1"
                                       SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" Width="160"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- ===== 输出与执行 ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="OutputSectionTitle" Text="输出" Style="{StaticResource CardTitleStyle}"/>

                    <controls:SettingRow x:Uid="MergeRowOutputPath" Title="输出文件">
                        <controls:SettingRow.SettingContent>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Uid="OutputPathBox"
                                         Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay}"
                                         PlaceholderText="输出文件路径" MinWidth="360"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource IconButtonStyle}"
                                        AutomationProperties.Name="{Binding Text, ElementName=SaveAsButtonText}"
                                        Command="{x:Bind ViewModel.PickOutputCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE792;" FontSize="16"/>
                                        <TextBlock x:Name="SaveAsButtonText" x:Uid="SaveAsButton" Text="另存为"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:OutputNameControl OutputNameOptions="{x:Bind ViewModel.OutputNameOptions}"
                                                 Margin="0,4"/>

                    <TextBlock x:Uid="CommandPreviewTitle" Text="命令预览" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource CodeBlockStyle}">
                        <TextBlock Text="{x:Bind ViewModel.CommandPreview, Mode=OneWay}"
                                   Style="{StaticResource MonospaceTextStyle}"/>
                    </Border>

                    <Button Style="{StaticResource AccentIconButtonStyle}"
                            Margin="0,16,0,0"
                            AutomationProperties.Name="{Binding Text, ElementName=AddToQueueButtonText}"
                            Command="{x:Bind ViewModel.AddToQueueCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="16"/>
                            <TextBlock x:Name="AddToQueueButtonText" x:Uid="AddToQueueButton" Text="添加到任务队列"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButtonStyle}"
                            Margin="0,16,0,0"
                            AutomationProperties.Name="扫描文件夹批量添加"
                            Command="{x:Bind ViewModel.ScanFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16"/>
                            <TextBlock Text="扫描文件夹批量添加"/>
                        </StackPanel>
                    </Button>

                    <InfoBar IsOpen="{x:Bind ViewModel.LastAddedVisible, Mode=OneWay}"
                             Message="{x:Bind ViewModel.LastAddedMessage, Mode=OneWay}"
                             Severity="Success"
                             Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
