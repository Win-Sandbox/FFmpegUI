<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FFmpegUI.Views.ExtractPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FFmpegUI.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32" Spacing="16" MaxWidth="1080" HorizontalAlignment="Stretch">

            <TextBlock x:Uid="ExtractPageTitle" Text="提取" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock x:Uid="ExtractPageSubtitle"
                       Text="从媒体文件中提取音频、视频、字幕，或按帧率抽取图片序列。"
                       Style="{StaticResource PageSubtitleStyle}"/>

            <InfoBar IsOpen="{x:Bind ViewModel.ShowStatus, Mode=OneWay}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                     IsClosable="True"/>

            <!-- ===== 输入文件 ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="InputSectionTitle" Text="输入文件" Style="{StaticResource CardTitleStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Uid="ExtractInputPathBox"
                                 Text="{x:Bind ViewModel.InputPath, Mode=TwoWay}"
                                 PlaceholderText="选择或粘贴要处理的媒体文件路径"/>
                        <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch"
                                Style="{StaticResource IconButtonStyle}"
                                AutomationProperties.Name="{Binding Text, ElementName=BrowseButtonText}"
                                Command="{x:Bind ViewModel.PickInputCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="16"/>
                                <TextBlock x:Name="BrowseButtonText" x:Uid="BrowseButton" Text="浏览"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.InputSummary, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- ===== 提取方式 ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="ExtractModeSectionTitle" Text="提取方式" Style="{StaticResource CardTitleStyle}"/>

                    <controls:SettingRow x:Uid="ExtractRowMode" Title="要提取的内容">
                        <controls:SettingRow.SettingContent>
                            <RadioButtons SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}" MaxColumns="2">
                                <RadioButton x:Uid="ExtractModeAudio" Content="提取音频"/>
                                <RadioButton x:Uid="ExtractModeVideo" Content="提取视频（去掉音频）"/>
                                <RadioButton x:Uid="ExtractModeSubtitle" Content="提取字幕"/>
                                <RadioButton x:Uid="ExtractModeFrame" Content="抽帧为图片"/>
                            </RadioButtons>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <!-- 音频 -->
                    <controls:SettingRow x:Uid="ExtractRowAudioFormat" Title="音频格式" Visibility="{x:Bind ViewModel.IsAudioMode, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.AudioContainers}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedIndex="{x:Bind ViewModel.AudioContainerIndex, Mode=TwoWay}"
                                      MinWidth="240"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="ExtractRowCopyAudio"
                                         Title="保持原始编码"
                                         Description="直接复制音轨，速度快且无损；关闭则重新编码"
                                         Visibility="{x:Bind ViewModel.IsAudioMode, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.CopyAudioStream, Mode=TwoWay}"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="ExtractRowAudioBitrate" Title="音频码率 (kbps)"
                                         Visibility="{x:Bind ViewModel.IsAudioBitrateVisible, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <NumberBox Value="{x:Bind ViewModel.AudioBitrateKbps, Mode=TwoWay}"
                                       Minimum="32" Maximum="1536" SmallChange="32"
                                       SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" MinWidth="160"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <!-- 视频 -->
                    <controls:SettingRow x:Uid="ExtractRowCopyVideo"
                                         Title="保持原始编码"
                                         Description="直接复制视频轨，仅去掉音频"
                                         Visibility="{x:Bind ViewModel.IsVideoMode, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.CopyVideoStream, Mode=TwoWay}"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <!-- 字幕 -->
                    <controls:SettingRow x:Uid="ExtractRowSubtitleStream"
                                         Title="字幕轨道"
                                         Description="选择文件后自动列出可用的字幕流"
                                         Visibility="{x:Bind ViewModel.IsSubtitleMode, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.SubtitleStreams, Mode=OneWay}"
                                      DisplayMemberPath="ListText"
                                      SelectedIndex="{x:Bind ViewModel.SubtitleStreamIndex, Mode=TwoWay}"
                                      MinWidth="420"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="ExtractRowSubtitleFormat" Title="字幕格式" Visibility="{x:Bind ViewModel.IsSubtitleMode, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.SubtitleFormats}"
                                      DisplayMemberPath="Key"
                                      SelectedIndex="{x:Bind ViewModel.SubtitleFormatIndex, Mode=TwoWay}"
                                      MinWidth="240"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <!-- 抽帧 -->
                    <controls:SettingRow x:Uid="ExtractRowFramesPerSecond" Title="每秒抽取帧数" Description="例如 1 表示每秒保存 1 张图片"
                                         Visibility="{x:Bind ViewModel.IsFrameMode, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <NumberBox Value="{x:Bind ViewModel.FramesPerSecond, Mode=TwoWay}"
                                       Minimum="0.01" Maximum="60" SmallChange="0.5"
                                       SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" Width="160"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="ExtractRowImageFormat" Title="图片格式" Visibility="{x:Bind ViewModel.IsFrameMode, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.ImageFormats}"
                                      DisplayMemberPath="Key"
                                      SelectedIndex="{x:Bind ViewModel.ImageFormatIndex, Mode=TwoWay}"
                                      MinWidth="200"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="ExtractRowStart" Title="起始时间（秒）" Description="0 表示从开头开始"
                                         Visibility="{x:Bind ViewModel.IsFrameMode, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <NumberBox Value="{x:Bind ViewModel.ExtractStartSeconds, Mode=TwoWay}"
                                       Minimum="0" Maximum="86400" SmallChange="1"
                                       SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" Width="160"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="ExtractRowDuration" Title="持续时长（秒）" Description="0 表示抽到文件结尾"
                                         Visibility="{x:Bind ViewModel.IsFrameMode, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <NumberBox Value="{x:Bind ViewModel.ExtractDurationSeconds, Mode=TwoWay}"
                                       Minimum="0" Maximum="86400" SmallChange="1"
                                       SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" Width="160"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="ExtractRowFrameFolder"
                                         Title="图片保存位置"
                                         Visibility="{x:Bind ViewModel.IsFrameMode, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Uid="ExtractFrameFolderBox"
                                         Text="{x:Bind ViewModel.FrameOutputDirectory, Mode=TwoWay}"
                                         PlaceholderText="选择保存图片的文件夹" MinWidth="300"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource IconButtonStyle}"
                                        AutomationProperties.Name="{Binding Text, ElementName=PickFolderButtonText}"
                                        Command="{x:Bind ViewModel.PickOutputCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="16"/>
                                        <TextBlock x:Name="PickFolderButtonText" x:Uid="PickFolderButton" Text="选择文件夹"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="ExtractRowFramePrefix" Title="文件名前缀" Description="最终文件名形如「前缀_00001.png」"
                                         Visibility="{x:Bind ViewModel.IsFrameMode, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <TextBox Text="{x:Bind ViewModel.FramePrefix, Mode=TwoWay}" MinWidth="240"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- ===== 输出与执行 ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="OutputSectionTitle" Text="输出" Style="{StaticResource CardTitleStyle}"/>

                    <controls:SettingRow x:Uid="ExtractRowOutputPath" Title="输出文件">
                        <controls:SettingRow.SettingContent>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Uid="OutputPathBox"
                                         Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay}"
                                         PlaceholderText="输出文件路径" MinWidth="360"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource IconButtonStyle}"
                                        AutomationProperties.Name="{Binding Text, ElementName=SaveAsButtonText}"
                                        Command="{x:Bind ViewModel.PickOutputCommand}"
                                        Visibility="{x:Bind ViewModel.IsFrameMode, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE792;" FontSize="16"/>
                                        <TextBlock x:Name="SaveAsButtonText" x:Uid="SaveAsButton" Text="另存为"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:OutputNameControl OutputNameOptions="{x:Bind ViewModel.OutputNameOptions}"
                                                 Margin="0,4"/>

                    <TextBlock x:Uid="CommandPreviewTitle" Text="命令预览" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource CodeBlockStyle}">
                        <TextBlock Text="{x:Bind ViewModel.CommandPreview, Mode=OneWay}"
                                   Style="{StaticResource MonospaceTextStyle}"/>
                    </Border>

                    <Button Style="{StaticResource AccentIconButtonStyle}"
                            Margin="0,16,0,0"
                            AutomationProperties.Name="{Binding Text, ElementName=AddToQueueButtonText}"
                            Command="{x:Bind ViewModel.AddToQueueCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="16"/>
                            <TextBlock x:Name="AddToQueueButtonText" x:Uid="AddToQueueButton" Text="添加到任务队列"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButtonStyle}"
                            Margin="0,16,0,0"
                            AutomationProperties.Name="扫描文件夹批量添加"
                            Command="{x:Bind ViewModel.ScanFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16"/>
                            <TextBlock Text="扫描文件夹批量添加"/>
                        </StackPanel>
                    </Button>

                    <InfoBar IsOpen="{x:Bind ViewModel.LastAddedVisible, Mode=OneWay}"
                             Message="{x:Bind ViewModel.LastAddedMessage, Mode=OneWay}"
                             Severity="Success"
                             Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
