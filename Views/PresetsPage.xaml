<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FFmpegUI.Views.PresetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FFmpegUI.Models"
    xmlns:viewmodels="using:FFmpegUI.ViewModels"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled"
    DataContext="{x:Bind ViewModel, Mode=OneTime}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32" Spacing="16" MaxWidth="1080" HorizontalAlignment="Stretch">

            <TextBlock Text="预设" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="点按某个预设即可直接处理文件；视频类先选输入再选输出，图片类先选文件再选输出文件夹。"
                       Style="{StaticResource PageSubtitleStyle}"/>

            <InfoBar IsOpen="{x:Bind ViewModel.ShowStatus, Mode=OneWay}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                     IsClosable="True"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="已保存的预设" Style="{StaticResource CardTitleStyle}"/>

                    <ListView x:Name="PresetList"
                              ItemsSource="{x:Bind ViewModel.Presets, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              Visibility="{x:Bind ViewModel.HasPresets, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Preset">
                                <Border Style="{StaticResource CardStyle}" Margin="0,4,0,4">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleStyle}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{x:Bind PageTitle}" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                                </Border>
                                                <TextBlock Text="{x:Bind Summary}" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Style="{StaticResource AccentIconButtonStyle}"
                                                    AutomationProperties.Name="运行此预设"
                                                    Command="{Binding ElementName=PresetList, Path=DataContext.RunPresetCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE768;" FontSize="16"/>
                                                    <TextBlock Text="运行"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}"
                                                    AutomationProperties.Name="删除预设"
                                                    Command="{Binding ElementName=PresetList, Path=DataContext.DeletePresetCommand}"
                                                    CommandParameter="{Binding}">
                                                <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Text="还没有保存任何预设。在任意功能页设置好参数后，点击窗口右上角的「保存预设」即可在此处复用。"
                               Style="{StaticResource PageSubtitleStyle}"
                               Visibility="{x:Bind ViewModel.EmptyHintVisible, Mode=OneWay}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
