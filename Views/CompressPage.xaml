<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FFmpegUI.Views.CompressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FFmpegUI.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32" Spacing="16" MaxWidth="1080" HorizontalAlignment="Stretch">

            <TextBlock x:Uid="CompressPageTitle" Text="压缩" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock x:Uid="CompressPageSubtitle"
                       Text="按目标文件大小或质量等级压缩视频，可同时降低分辨率以进一步减小体积。"
                       Style="{StaticResource PageSubtitleStyle}"/>

            <InfoBar IsOpen="{x:Bind ViewModel.ShowStatus, Mode=OneWay}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                     IsClosable="True"/>

            <!-- ===== 输入文件 ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="InputSectionTitle" Text="输入文件" Style="{StaticResource CardTitleStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Uid="CompressInputPathBox"
                                 Text="{x:Bind ViewModel.InputPath, Mode=TwoWay}"
                                 PlaceholderText="选择或粘贴要压缩的文件路径"/>
                        <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch"
                                Style="{StaticResource IconButtonStyle}"
                                AutomationProperties.Name="{Binding Text, ElementName=BrowseButtonText}"
                                Command="{x:Bind ViewModel.PickInputCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="16"/>
                                <TextBlock x:Name="BrowseButtonText" x:Uid="BrowseButton" Text="浏览"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.InputSummary, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- ===== 压缩策略 ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="CompressStrategySectionTitle" Text="压缩策略" Style="{StaticResource CardTitleStyle}"/>

                    <controls:SettingRow x:Uid="CompressRowMode" Title="压缩方式" Description="按目标体积时会自动换算所需码率">
                        <controls:SettingRow.SettingContent>
                            <RadioButtons SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}" MaxColumns="2">
                                <RadioButton x:Uid="CompressModeSize" Content="按目标文件大小"/>
                                <RadioButton x:Uid="CompressModeQuality" Content="按质量（CRF）"/>
                            </RadioButtons>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="CompressRowTargetSize" Title="目标文件大小 (MB)"
                                         Visibility="{x:Bind ViewModel.IsTargetSizeMode, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <StackPanel Spacing="4">
                                <NumberBox Value="{x:Bind ViewModel.TargetSizeMb, Mode=TwoWay}"
                                           Minimum="1" Maximum="100000" SmallChange="10"
                                           SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" MinWidth="160"/>
                                <TextBlock Text="{x:Bind ViewModel.EstimatedBitrateText, Mode=OneWay}"
                                           Style="{StaticResource FieldHintStyle}"/>
                            </StackPanel>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="CompressRowCrf" Title="质量 CRF" Description="0–51，推荐 26–30 用于压缩"
                                         Visibility="{x:Bind ViewModel.IsQualityMode, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Slider Minimum="0" Maximum="51" StepFrequency="1" HorizontalAlignment="Stretch" MaxWidth="240"
                                        Value="{x:Bind ViewModel.Crf, Mode=TwoWay}"/>
                                <NumberBox Value="{x:Bind ViewModel.Crf, Mode=TwoWay}"
                                           Minimum="0" Maximum="51" SmallChange="1"
                                           SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" MinWidth="120"/>
                            </StackPanel>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="CompressRowScale" Title="分辨率缩放" Description="{x:Bind ViewModel.TargetResolutionText, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.ScalePercents}"
                                      DisplayMemberPath="Key"
                                      SelectedIndex="{x:Bind ViewModel.ScalePercentIndex, Mode=TwoWay}"
                                      MinWidth="240"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="CompressRowScaleAlgorithm" Title="缩放算法">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.ScaleAlgorithms}"
                                      DisplayMemberPath="Key"
                                      SelectedIndex="{x:Bind ViewModel.ScaleAlgorithmIndex, Mode=TwoWay}"
                                      MinWidth="240"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- ===== 编码参数 ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="CompressEncodeSectionTitle" Text="编码参数" Style="{StaticResource CardTitleStyle}"/>

                    <controls:SettingRow x:Uid="CompressRowContainer" Title="容器格式">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.Containers}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedIndex="{x:Bind ViewModel.ContainerIndex, Mode=TwoWay}"
                                      MinWidth="240"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="CompressRowPreset" Title="编码预设" Description="越慢压缩率越高，速度越慢">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.Presets}"
                                      SelectedIndex="{x:Bind ViewModel.PresetIndex, Mode=TwoWay}"
                                      MinWidth="200"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="CompressRowAudioBitrate" Title="音频码率 (kbps)">
                        <controls:SettingRow.SettingContent>
                            <NumberBox Value="{x:Bind ViewModel.AudioBitrateKbps, Mode=TwoWay}"
                                       Minimum="32" Maximum="1536" SmallChange="32"
                                       SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" Width="160"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="CompressRowHardwareAccel" Title="使用 NVIDIA 显卡编码" Description="未安装 NVIDIA 显卡时请勿启用">
                        <controls:SettingRow.SettingContent>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.UseHardwareAccel, Mode=TwoWay}"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- ===== 输出与执行 ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="OutputSectionTitle" Text="输出" Style="{StaticResource CardTitleStyle}"/>

                    <controls:SettingRow x:Uid="CompressRowOutputPath" Title="输出文件">
                        <controls:SettingRow.SettingContent>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Uid="OutputPathBox"
                                         Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay}"
                                         PlaceholderText="输出文件路径" MinWidth="360"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource IconButtonStyle}"
                                        AutomationProperties.Name="{Binding Text, ElementName=SaveAsButtonText}"
                                        Command="{x:Bind ViewModel.PickOutputCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE792;" FontSize="16"/>
                                        <TextBlock x:Name="SaveAsButtonText" x:Uid="SaveAsButton" Text="另存为"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:OutputNameControl OutputNameOptions="{x:Bind ViewModel.OutputNameOptions}"
                                                 Margin="0,4"/>

                    <TextBlock x:Uid="CommandPreviewTitle" Text="命令预览" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource CodeBlockStyle}">
                        <TextBlock Text="{x:Bind ViewModel.CommandPreview, Mode=OneWay}"
                                   Style="{StaticResource MonospaceTextStyle}"/>
                    </Border>

                    <Button Style="{StaticResource AccentIconButtonStyle}"
                            Margin="0,16,0,0"
                            AutomationProperties.Name="{Binding Text, ElementName=AddToQueueButtonText}"
                            Command="{x:Bind ViewModel.AddToQueueCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="16"/>
                            <TextBlock x:Name="AddToQueueButtonText" x:Uid="AddToQueueButton" Text="添加到任务队列"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButtonStyle}"
                            Margin="0,16,0,0"
                            AutomationProperties.Name="扫描文件夹批量添加"
                            Command="{x:Bind ViewModel.ScanFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16"/>
                            <TextBlock Text="扫描文件夹批量添加"/>
                        </StackPanel>
                    </Button>

                    <InfoBar IsOpen="{x:Bind ViewModel.LastAddedVisible, Mode=OneWay}"
                             Message="{x:Bind ViewModel.LastAddedMessage, Mode=OneWay}"
                             Severity="Success"
                             Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
