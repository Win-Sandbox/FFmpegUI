<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FFmpegUI.Views.TranscodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FFmpegUI.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32" Spacing="16" MaxWidth="1080" HorizontalAlignment="Stretch">

            <TextBlock x:Uid="TranscodePageTitle" Text="转码" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock x:Uid="TranscodePageSubtitle"
                       Text="将视频或音频转换为其它格式，可自由选择编码器、码率、分辨率与帧率。"
                       Style="{StaticResource PageSubtitleStyle}"/>

            <!-- 操作结果提示（官方 InfoBar 控件） -->
            <InfoBar IsOpen="{x:Bind ViewModel.ShowStatus, Mode=OneWay}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                     IsClosable="True"/>

            <!-- ===== 输入文件 ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="InputSectionTitle" Text="输入文件" Style="{StaticResource CardTitleStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Uid="TranscodeInputPathBox"
                                 Text="{x:Bind ViewModel.InputPath, Mode=TwoWay}"
                                 PlaceholderText="选择或粘贴要转换的文件路径"
                                 IsReadOnly="False"/>
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Stretch"
                                Style="{StaticResource IconButtonStyle}"
                                AutomationProperties.Name="{Binding Text, ElementName=BrowseButtonText}"
                                Command="{x:Bind ViewModel.PickInputCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="16"/>
                                <TextBlock x:Name="BrowseButtonText" x:Uid="BrowseButton" Text="浏览"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <ProgressRing Width="16" Height="16"
                                      IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.InputSummary, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== 输出设置 ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="TranscodeOutputSectionTitle" Text="输出" Style="{StaticResource CardTitleStyle}"/>

                    <controls:SettingRow x:Uid="TranscodeRowContainer" Title="容器格式" Description="决定文件扩展名与默认编码器">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.Containers}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedIndex="{x:Bind ViewModel.ContainerIndex, Mode=TwoWay}"
                                      MinWidth="240"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowOutputPath" Title="输出文件">
                        <controls:SettingRow.SettingContent>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Uid="OutputPathBox"
                                         Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay}"
                                         PlaceholderText="输出文件路径"
                                         MinWidth="360"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource IconButtonStyle}"
                                        AutomationProperties.Name="{Binding Text, ElementName=SaveAsButtonText}"
                                        Command="{x:Bind ViewModel.PickOutputCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE792;" FontSize="16"/>
                                        <TextBlock x:Name="SaveAsButtonText" x:Uid="SaveAsButton" Text="另存为"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- ===== 视频编码 ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="TranscodeVideoSectionTitle" Text="视频" Style="{StaticResource CardTitleStyle}"/>

                    <controls:SettingRow x:Uid="TranscodeRowKeepVideo" Title="保留视频流">
                        <controls:SettingRow.SettingContent>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.KeepVideo, Mode=TwoWay}"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowVideoCodec" Title="视频编码器" Description="带 * 的为推荐选项">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.VideoCodecs}"
                                      DisplayMemberPath="Value"
                                      SelectedIndex="{x:Bind ViewModel.VideoCodecIndex, Mode=TwoWay}"
                                      MinWidth="280"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowRateControl"
                                         Title="码率控制方式"
                                         Description="CRF 恒定质量适合大多数场景；目标体积适合有大小限制的情况"
                                         Visibility="{x:Bind ViewModel.KeepVideo, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <RadioButtons SelectedIndex="{x:Bind ViewModel.VideoRateControlIndex, Mode=TwoWay}"
                                          MaxColumns="3">
                                <RadioButton x:Uid="TranscodeRcCrf" Content="恒定质量 CRF"/>
                                <RadioButton x:Uid="TranscodeRcQp" Content="恒定量化 QP"/>
                                <RadioButton x:Uid="TranscodeRcAverage" Content="平均码率"/>
                                <RadioButton x:Uid="TranscodeRcCbr" Content="恒定码率 CBR"/>
                                <RadioButton x:Uid="TranscodeRcTargetSize" Content="目标体积"/>
                                <RadioButton x:Uid="TranscodeRcCopy" Content="直接复制"/>
                            </RadioButtons>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <!-- CRF：滑块 + 数字框（官方 Slider/NumberBox 组合用法） -->
                    <controls:SettingRow x:Uid="TranscodeRowCrf" Title="CRF 值" Description="0–51，数值越小质量越高、体积越大"
                                         Visibility="{x:Bind ViewModel.IsCrfVisible, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Slider Minimum="0" Maximum="51" StepFrequency="1"
                                        HorizontalAlignment="Stretch" MaxWidth="240"
                                        Value="{x:Bind ViewModel.Crf, Mode=TwoWay}"/>
                                <NumberBox Value="{x:Bind ViewModel.Crf, Mode=TwoWay}"
                                           Minimum="0" Maximum="51" SmallChange="1"
                                           SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten"
                                           MinWidth="120"/>
                            </StackPanel>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowQp" Title="QP 值" Description="0–51，仅在恒定量化模式下生效"
                                         Visibility="{x:Bind ViewModel.IsQpVisible, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <NumberBox Value="{x:Bind ViewModel.Qp, Mode=TwoWay}"
                                       Minimum="0" Maximum="51" SmallChange="1"
                                       SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" MinWidth="160"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowBitrate" Title="视频码率 (kbps)"
                                         Visibility="{x:Bind ViewModel.IsBitrateVisible, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <NumberBox Value="{x:Bind ViewModel.VideoBitrateKbps, Mode=TwoWay}"
                                       Minimum="100" Maximum="200000" SmallChange="500"
                                       SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" MinWidth="160"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <StackPanel Visibility="{x:Bind ViewModel.IsCbrVisible, Mode=OneWay}">
                        <controls:SettingRow x:Uid="TranscodeRowCbrBitrate" Title="目标码率 (kbps)">
                            <controls:SettingRow.SettingContent>
                                <NumberBox Value="{x:Bind ViewModel.VideoBitrateKbps, Mode=TwoWay}"
                                           Minimum="100" Maximum="200000" SmallChange="500"
                                           SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" MinWidth="160"/>
                            </controls:SettingRow.SettingContent>
                        </controls:SettingRow>
                        <controls:SettingRow x:Uid="TranscodeRowCbrMax" Title="最大码率 (kbps)">
                            <controls:SettingRow.SettingContent>
                                <NumberBox Value="{x:Bind ViewModel.MaxBitrateKbps, Mode=TwoWay}"
                                           Minimum="100" Maximum="200000" SmallChange="500"
                                           SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" MinWidth="160"/>
                            </controls:SettingRow.SettingContent>
                        </controls:SettingRow>
                        <controls:SettingRow x:Uid="TranscodeRowCbrBuffer" Title="缓冲区大小 (kbps)">
                            <controls:SettingRow.SettingContent>
                                <NumberBox Value="{x:Bind ViewModel.BufferSizeKbps, Mode=TwoWay}"
                                           Minimum="100" Maximum="400000" SmallChange="500"
                                           SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" MinWidth="160"/>
                            </controls:SettingRow.SettingContent>
                        </controls:SettingRow>
                    </StackPanel>

                    <controls:SettingRow x:Uid="TranscodeRowTargetSize"
                                         Title="目标文件大小 (MB)"
                                         Description="按文件时长自动换算所需码率"
                                         Visibility="{x:Bind ViewModel.IsTargetSizeVisible, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <NumberBox Value="{x:Bind ViewModel.TargetSizeMb, Mode=TwoWay}"
                                       Minimum="1" Maximum="100000" SmallChange="10"
                                       SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" MinWidth="160"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowPreset" Title="编码预设" Description="越慢压缩率越高，速度越慢"
                                         Visibility="{x:Bind ViewModel.IsPresetVisible, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.Presets}"
                                      SelectedIndex="{x:Bind ViewModel.PresetIndex, Mode=TwoWay}"
                                      MinWidth="200"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowTune" Title="调优 (tune)"
                                         Visibility="{x:Bind ViewModel.IsVideoEncodeVisible, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.Tunes}"
                                      DisplayMemberPath="Value"
                                      SelectedIndex="{x:Bind ViewModel.TuneIndex, Mode=TwoWay}"
                                      MinWidth="240"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowProfile" Title="编码档次 (profile)"
                                         Visibility="{x:Bind ViewModel.IsVideoEncodeVisible, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.Profiles}"
                                      SelectedIndex="{x:Bind ViewModel.ProfileIndex, Mode=TwoWay}"
                                      MinWidth="200"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowPixelFormat" Title="像素格式" Description="不确定时保持「自动」"
                                         Visibility="{x:Bind ViewModel.IsVideoEncodeVisible, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.PixelFormats}"
                                      DisplayMemberPath="Value"
                                      SelectedIndex="{x:Bind ViewModel.PixelFormatIndex, Mode=TwoWay}"
                                      MinWidth="280"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowHardwareAccel" Title="硬件加速" Description="使用显卡编码前请确认驱动支持"
                                         Visibility="{x:Bind ViewModel.IsVideoEncodeVisible, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.HardwareAccels}"
                                      DisplayMemberPath="Key"
                                      SelectedIndex="{x:Bind ViewModel.HardwareAccelIndex, Mode=TwoWay}"
                                      MinWidth="240"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- ===== 分辨率与帧率 ===== -->
            <Border Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.KeepVideo, Mode=OneWay}">
                <StackPanel>
                    <TextBlock x:Uid="TranscodeResolutionSectionTitle" Text="分辨率与帧率" Style="{StaticResource CardTitleStyle}"/>

                    <controls:SettingRow x:Uid="TranscodeRowResolutionPreset" Title="分辨率预设" Description="也可在下方自定义宽高（偶数更兼容）">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.Resolutions}"
                                      DisplayMemberPath="Key"
                                      SelectedIndex="{x:Bind ViewModel.ResolutionIndex, Mode=TwoWay}"
                                      MinWidth="240"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowCustomSize" Title="自定义宽高" Description="原分辨率：">
                        <controls:SettingRow.SettingContent>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <NumberBox x:Uid="WidthNumberBox"
                                           Value="{x:Bind ViewModel.Width, Mode=TwoWay}"
                                           Minimum="0" Maximum="15360" SmallChange="2"
                                           SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten"
                                           PlaceholderText="宽" MinWidth="120"/>
                                <TextBlock Text="×" VerticalAlignment="Center"/>
                                <NumberBox x:Uid="HeightNumberBox"
                                           Value="{x:Bind ViewModel.Height, Mode=TwoWay}"
                                           Minimum="0" Maximum="15360" SmallChange="2"
                                           SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten"
                                           PlaceholderText="高" MinWidth="120"/>
                            </StackPanel>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowScaleAlgorithm" Title="缩放算法">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.ScaleAlgorithms}"
                                      DisplayMemberPath="Key"
                                      SelectedIndex="{x:Bind ViewModel.ScaleAlgorithmIndex, Mode=TwoWay}"
                                      MinWidth="240"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowFrameRate" Title="帧率">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.FrameRates}"
                                      DisplayMemberPath="Key"
                                      SelectedIndex="{x:Bind ViewModel.FrameRateIndex, Mode=TwoWay}"
                                      MinWidth="240"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowKeyframe" Title="关键帧间隔 (GOP)" Description="0 表示使用编码器默认值">
                        <controls:SettingRow.SettingContent>
                            <NumberBox Value="{x:Bind ViewModel.KeyframeInterval, Mode=TwoWay}"
                                       Minimum="0" Maximum="1000" SmallChange="10"
                                       SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" MinWidth="160"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowThreads" Title="编码线程数" Description="0 表示由 FFmpeg 自动决定">
                        <controls:SettingRow.SettingContent>
                            <NumberBox Value="{x:Bind ViewModel.Threads, Mode=TwoWay}"
                                       Minimum="0" Maximum="128" SmallChange="1"
                                       SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" MinWidth="160"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- ===== 音频 ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="TranscodeAudioSectionTitle" Text="音频" Style="{StaticResource CardTitleStyle}"/>

                    <controls:SettingRow x:Uid="TranscodeRowKeepAudio" Title="保留音频流">
                        <controls:SettingRow.SettingContent>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.KeepAudio, Mode=TwoWay}"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowAudioCodec" Title="音频编码器" Description="带 * 的为推荐选项">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.AudioCodecs}"
                                      DisplayMemberPath="Value"
                                      SelectedIndex="{x:Bind ViewModel.AudioCodecIndex, Mode=TwoWay}"
                                      MinWidth="280"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowAudioRateControl"
                                         Title="音频码率控制"
                                         Visibility="{x:Bind ViewModel.KeepAudio, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <RadioButtons SelectedIndex="{x:Bind ViewModel.AudioRateControlIndex, Mode=TwoWay}"
                                          MaxColumns="3">
                                <RadioButton x:Uid="TranscodeArcBitrate" Content="指定码率"/>
                                <RadioButton x:Uid="TranscodeArcQuality" Content="质量 (VBR)"/>
                                <RadioButton x:Uid="TranscodeArcCopy" Content="直接复制"/>
                            </RadioButtons>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowAudioBitrate" Title="音频码率 (kbps)"
                                         Visibility="{x:Bind ViewModel.IsAudioEncodeVisible, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <NumberBox Value="{x:Bind ViewModel.AudioBitrateKbps, Mode=TwoWay}"
                                       Minimum="32" Maximum="1536" SmallChange="32"
                                       SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" MinWidth="160"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowAudioQuality" Title="音频质量" Description="数值越小质量越高（VBR 模式）"
                                         Visibility="{x:Bind ViewModel.IsAudioEncodeVisible, Mode=OneWay}">
                        <controls:SettingRow.SettingContent>
                            <NumberBox Value="{x:Bind ViewModel.AudioQuality, Mode=TwoWay}"
                                       Minimum="0" Maximum="10" SmallChange="1"
                                       SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" MinWidth="160"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowSampleRate" Title="采样率">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.SampleRates}"
                                      DisplayMemberPath="Key"
                                      SelectedIndex="{x:Bind ViewModel.SampleRateIndex, Mode=TwoWay}"
                                      MinWidth="200"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowChannels" Title="声道数">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.ChannelOptions}"
                                      DisplayMemberPath="Key"
                                      SelectedIndex="{x:Bind ViewModel.ChannelIndex, Mode=TwoWay}"
                                      MinWidth="200"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- ===== 字幕与高级 ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Uid="TranscodeAdvancedSectionTitle" Text="字幕与高级选项" Style="{StaticResource CardTitleStyle}"/>

                    <controls:SettingRow x:Uid="TranscodeRowKeepSubtitle" Title="保留字幕流">
                        <controls:SettingRow.SettingContent>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.KeepSubtitle, Mode=TwoWay}"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowSubtitleCodec" Title="字幕编码器" Description="部分容器不支持字幕，将自动忽略">
                        <controls:SettingRow.SettingContent>
                            <ComboBox ItemsSource="{x:Bind ViewModel.SubtitleCodecs}"
                                      DisplayMemberPath="Value"
                                      SelectedIndex="{x:Bind ViewModel.SubtitleCodecIndex, Mode=TwoWay}"
                                      MinWidth="280"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowFastStart"
                                         Title="优化网络播放 (faststart)"
                                         Description="把 MP4/MOV 的索引信息移到文件头部">
                        <controls:SettingRow.SettingContent>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.FastStart, Mode=TwoWay}"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowKeepMetadata" Title="保留元数据">
                        <controls:SettingRow.SettingContent>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.KeepMetadata, Mode=TwoWay}"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowKeepChapters" Title="保留章节信息">
                        <controls:SettingRow.SettingContent>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.KeepChapters, Mode=TwoWay}"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>

                    <controls:SettingRow x:Uid="TranscodeRowExtraArgs" Title="附加输出参数" Description="追加在输出文件之前的自定义参数">
                        <controls:SettingRow.SettingContent>
                            <TextBox x:Uid="TranscodeExtraArgsBox"
                                     Text="{x:Bind ViewModel.CustomOutputArguments, Mode=TwoWay}"
                                     PlaceholderText="例如：-movflags +faststart -metadata title=示例"
                                     MinWidth="420"/>
                        </controls:SettingRow.SettingContent>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- ===== 命令预览与执行 ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <controls:OutputNameControl OutputNameOptions="{x:Bind ViewModel.OutputNameOptions}"
                                                 Margin="0,4"/>

                    <TextBlock x:Uid="CommandPreviewTitle" Text="命令预览" Style="{StaticResource SectionHeaderStyle}"/>

                    <Border Style="{StaticResource CodeBlockStyle}">
                        <TextBlock Text="{x:Bind ViewModel.CommandPreview, Mode=OneWay}"
                                   Style="{StaticResource MonospaceTextStyle}"/>
                    </Border>

                    <Button Style="{StaticResource AccentIconButtonStyle}"
                            Margin="0,16,0,0"
                            AutomationProperties.Name="{Binding Text, ElementName=AddToQueueButtonText}"
                            Command="{x:Bind ViewModel.AddToQueueCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="16"/>
                            <TextBlock x:Name="AddToQueueButtonText" x:Uid="AddToQueueButton" Text="添加到任务队列"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButtonStyle}"
                            Margin="0,16,0,0"
                            AutomationProperties.Name="扫描文件夹批量添加"
                            Command="{x:Bind ViewModel.ScanFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16"/>
                            <TextBlock Text="扫描文件夹批量添加"/>
                        </StackPanel>
                    </Button>

                    <InfoBar IsOpen="{x:Bind ViewModel.LastAddedVisible, Mode=OneWay}"
                             Message="{x:Bind ViewModel.LastAddedMessage, Mode=OneWay}"
                             Severity="Success"
                             Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
