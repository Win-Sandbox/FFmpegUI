<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="FFmpegUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:FFmpegUI.Helpers">
    <Application.Resources>
        <!-- 注意（WMC0035）：本字典**不能**同时包含直接资源项与 MergedDictionaries。
             两者都会写入 ResourceDictionary 的 _Items 集合，
             若 MergedDictionaries 夹在中间，_Items 会被分段赋值两次而编译报错。
             因此所有自定义资源要么全部作为直接项、要么全部放进被合并的独立字典。 -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 必须：引入 WinUI 控件主题资源（Learn《XAML 主题资源》要求） -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!-- Mica/材质透出（官方《Apply Mica in desktop apps》）：
                     NavigationView 展开态侧栏默认背景为不透明纯色，会把窗口材质挡住，
                     官方要求把该资源覆写为 Transparent，使侧栏与标题栏、内容层一起透出系统材质。
                     注意：ThemeDictionaries 必须放在独立的 ResourceDictionary 内再合并——
                     同一个字典上直接资源和 ThemeDictionaries 并列会报 WMC0035。 -->
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <!-- Light / Dark / HighContrast 三套必须齐全（官方《NavigationView》：
                             至少 Default + HighContrast，但 WinUI 模板实际用 Light/Dark 区分深浅色，
                             缺 Dark 会导致深色下 pane 透明后透出纯黑背景、文字不可见） -->
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>

                <!-- ========== 值转换器 ==========
                     单独放一个被合并的字典，避免与根字典的直接资源项冲突（WMC0035）。
                     供 x:Bind 使用：x:Bind 是强类型绑定，bool→可见性、数值→文本
                     这类转换必须显式提供转换器，不能依赖隐式类型转换。 -->
                <ResourceDictionary>
                    <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
                    <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
                    <helpers:BoolToErrorBrushConverter x:Key="BoolToErrorBrushConverter"/>
                    <helpers:ImageItemToGlyphConverter x:Key="ImageItemToGlyphConverter"/>
                    <helpers:BoolToPlayTextConverter x:Key="BoolToPlayTextConverter"/>
                    <helpers:NumberToStringConverter x:Key="NumberToStringConverter"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <!-- ========== 布局规范 ==========
                 间距取 4 的倍数；圆角使用 ControlCornerRadius（8px）以匹配 WinUI 3 默认。 -->

            <Thickness x:Key="CardPadding">16</Thickness>
            <Thickness x:Key="CardPaddingNarrow">12,8</Thickness>
            <!-- 说明：设置行的右侧控件列不再设统一最小宽度（FieldMinWidth 已移除）。
                 各控件（ComboBox/NumberBox/滑块组）在自身 XAML 中声明宽度，
                 ToggleSwitch 等无显式宽度的控件按固有宽度靠右排列，
                 这样开关才能真正贴到行尾（见 SettingRow.xaml 注释）。 -->

            <!-- 设置/参数卡片容器：CardBackgroundFillColorDefaultBrush 为官方卡片层级背景 -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
                <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
            </Style>

            <!-- 卡片标题 -->
            <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <!-- 卡片内分组小标题 -->
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Setter Property="Margin" Value="0,16,0,8"/>
            </Style>

            <!-- 表单控件下方的说明文字 -->
            <Style x:Key="FieldHintStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- 页面标题 -->
            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <!-- 页面副标题（说明） -->
            <Style x:Key="PageSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="Margin" Value="0,0,0,20"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- 命令预览等宽文本 -->
            <Style x:Key="MonospaceTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            </Style>

            <!-- 代码编辑框 -->
            <Style x:Key="CodeTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="AcceptsReturn" Value="True"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            </Style>

            <!-- 命令预览代码块容器：LayerFillColorDefaultBrush 用于在卡片/材质上再叠一层 -->
            <Style x:Key="CodeBlockStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="IsTabStop" Value="False"/>
            </Style>

            <!-- 图标+文本按钮：减少重复 StackPanel，统一内边距 -->
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="MinWidth" Value="0"/>
            </Style>

            <Style x:Key="AccentIconButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="MinWidth" Value="0"/>
            </Style>

            <!-- 空状态（居中大图标 + 说明） -->
            <Style x:Key="EmptyStateIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="48"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="EmptyStateTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,12,0,4"/>
            </Style>

            <Style x:Key="EmptyStateDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- ========== 数据模板 ========== -->

            <!-- 任务列表项：左侧状态图标 + 标题/输出 + 进度条 + 右侧状态文本 -->
            <DataTemplate x:Key="TaskItemTemplate">
                <Grid Padding="0,10" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 状态图标 -->
                    <FontIcon Grid.Row="0" Grid.RowSpan="2"
                              Glyph="{Binding StateGlyph}"
                              FontSize="20"
                              VerticalAlignment="Top"
                              Margin="0,2,0,0"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <!-- 文件名 -->
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding DisplayName}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{Binding DisplayName}"/>

                    <!-- 状态标签 -->
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="{Binding StatusText}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>

                    <!-- 输出路径 -->
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                               Text="{Binding OutputPath}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0"/>

                    <!-- 进度条 -->
                    <ProgressBar Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                 Margin="0,8,0,0"
                                 Value="{Binding Progress}"
                                 Maximum="100"
                                 IsIndeterminate="{Binding IsIndeterminate}"/>

                    <!-- 进度详情 -->
                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                               Text="{Binding ProgressDetailText}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </Grid>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>