<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FFmpegUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:FFmpegUI.Views"
    mc:Ignorable="d"
    Title="FFmpegUI">

	<!-- 背景说明：使用系统材质（Mica/Acrylic）时窗口内容必须透明才能透出材质
	     （官方《Apply Mica in desktop apps》要求）。WinUI 3 未提供
	     SolidBackgroundFillColorTransparentBrush（该键仅存在于 WinUI 2/UWP）——
	     WinUI 3 只有 Base/Secondary/Tertiary/Quarternary/Disabled 五个 SolidBackgroundFillColor 键，
	     引用不存在的 ThemeResource 键编译期不报错、运行时直接抛 XamlParseException 启动崩溃。
	     不使用材质时由 MainWindow.UpdateBackdropFallback() 换成不透明回退色。 -->
	<Grid x:Name="RootGrid" Background="Transparent">
		<Grid.RowDefinitions>
			<RowDefinition Height="48"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- 官方 TitleBar 控件（WinAppSDK）：自带标题按钮承载、拖动区域计算与窗格切换按钮 -->
		<TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="FFmpegUI"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="AppTitleBar_PaneToggleRequested">
			<TitleBar.IconSource>
				<FontIconSource Glyph="&#xE714;"/>
			</TitleBar.IconSource>
			<TitleBar.Content>
				<Button x:Name="SavePresetButton"
                        Margin="0,0,12,0"
                        Click="SavePresetButton_Click"
						ToolTipService.ToolTip="将当前页面的参数保存为预设，下次在预设栏直接复用">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<FontIcon Glyph="&#xE74E;" FontSize="16"/>
						<TextBlock Text="保存预设"/>
					</StackPanel>
				</Button>
			</TitleBar.Content>
		</TitleBar>

		<NavigationView x:Name="NavView"
                        Grid.Row="1"
                        IsSettingsVisible="True"
                        IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="LeftCompact"
                        IsPaneToggleButtonVisible="False"
                        CompactPaneLength="48"
                        OpenPaneLength="280"
                        AlwaysShowHeader="False"
                        SelectionChanged="NavView_SelectionChanged"
                        Loaded="NavView_Loaded">

			<NavigationView.MenuItems>
				<NavigationViewItem x:Name="NavTranscode"
                                    x:Uid="NavTranscode"
                                    Content="转码"
                                    Tag="transcode"
                                    Icon="Video"/>
				<NavigationViewItem x:Uid="NavTrim"
                                    Content="剪辑"
                                    Tag="trim"
                                    Icon="Trim"/>
				<NavigationViewItem x:Uid="NavExtract"
                                    Content="提取"
                                    Tag="extract"
                                    Icon="Download"/>
				<NavigationViewItem x:Uid="NavMerge"
                                    Content="合并与混流"
                                    Tag="merge"
                                    Icon="Link"/>
				<NavigationViewItem x:Uid="NavCompress"
                                    Content="压缩"
                                    Tag="compress"
                                    Icon="Manage"/>
				<NavigationViewItem x:Uid="NavAdvanced"
                                    Content="高级参数"
                                    Tag="advanced"
                                    Icon="Edit"/>

				<NavigationViewItemSeparator/>

				<NavigationViewItem Content="信息探测"
                                    Tag="probe"
                                    Icon="View"/>
				<NavigationViewItem Content="图片转换"
                                    Tag="image"
                                    Icon="Pictures"/>
				<NavigationViewItem Content="播放"
                                    Tag="play"
                                    Icon="Play"/>

				<NavigationViewItem Content="预设"
                                    Tag="presets"
                                    Icon="Favorite"/>

				<NavigationViewItemSeparator/>

				<NavigationViewItem x:Uid="NavTasks"
                                    Content="任务队列"
                                    Tag="tasks"
                                    Icon="List"/>
			</NavigationView.MenuItems>

			<Frame x:Name="ContentFrame"/>
		</NavigationView>

		<!-- FFmpeg 未配置时的常驻提示条（官方 InfoBar） -->
		<InfoBar x:Name="FfmpegStatusBar"
                 x:Uid="FfmpegStatusBar"
                 Grid.Row="2"
                 Severity="Warning"
                 Title="尚未配置 FFmpeg"
                 Message="请打开设置页指定 ffmpeg.exe 与 ffprobe.exe，或点击右侧按钮自动探测。"
                 IsClosable="True"
                 IsOpen="False"
                 Margin="16,0,16,16">
			<InfoBar.ActionButton>
				<Button x:Uid="OpenSettingsButton"
                        Content="打开设置"
                        Click="OpenSettingsButton_Click"/>
			</InfoBar.ActionButton>
		</InfoBar>
	</Grid>
</Window>